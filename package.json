    "@types/node": "^20.19.43",
    "@types/three": "^0.180.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
